RUNNER_BOT_TOKEN=8727722492:AAF6yUrT7bMdjs7TQrgj4D5Hp7udSm9eNnM

# ---------------------------------------------------------------------------
# Database (MongoDB Atlas -- a hosted database, NOT a local file, so your
# data survives dyno restarts/redeploys on Heroku and similar hosts).
#
# Get a free connection string in ~5 minutes:
#   1. Sign up at https://cloud.mongodb.com (no credit card needed for the
#      free M0 tier -- 512MB storage, no time limit).
#   2. Create a free "M0" cluster.
#   3. Database Access -> Add New Database User (username + password).
#   4. Network Access -> Add IP Address -> "Allow Access from Anywhere"
#      (0.0.0.0/0) -- needed since Heroku dynos don't have a fixed IP.
#   5. Database -> Connect -> Drivers -> copy the connection string, it
#      looks like: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/
#   6. Paste it below, filling in your real username/password.
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://alexaditya:alexaditya950@cluster0.7j1hfjk.mongodb.net/?appName=Cluster0
MONGODB_DB_NAME=quizbot

# ---------------------------------------------------------------------------
# Ownership / admin access
# ---------------------------------------------------------------------------
OWNER_ID=8644019747
ADMIN_IDS=8644019747

# ---------------------------------------------------------------------------
# Channels / groups (optional -- leave blank to disable related features)
# ---------------------------------------------------------------------------
LOG_GROUP=-1004389073908
BOT_GROUP=-1004389073908
CHANNEL_ID=-1004389073908
REQUIRED_SUB_CHANNEL=free_quiz_all_exam

# ---------------------------------------------------------------------------
# Feature flags
# ---------------------------------------------------------------------------
# If true, every user is treated as premium (useful for a fully free deployment)
FREE_BOT=True

# ---------------------------------------------------------------------------
# Payments (Razorpay) -- leave blank to disable the /pay premium-purchase flow
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PLAN_1_MONTH_AMOUNT=9900
PLAN_3_MONTH_AMOUNT=24900
PLAN_1_YEAR_AMOUNT=79900

# ---------------------------------------------------------------------------
# Optional external PDF-generation microservice for /testseries (purchase this api for premiuim quality pdf)
# ---------------------------------------------------------------------------
PDF_API_BASE=

# ---------------------------------------------------------------------------
# Quiz Player Mini App (Telegram WebApp) -- the visual "Play" button added
# after quiz creation and on inline-share cards. Leave MINI_APP_DOMAIN blank
# to disable the feature entirely: no Play buttons are shown and the server
# doesn't auto-start with `python run.py`.
# ---------------------------------------------------------------------------
# Public HTTPS domain the Mini App is served from, e.g. https://play.example.com
# Telegram REQUIRES a public HTTPS URL for WebApp buttons -- put a reverse
# proxy / tunnel (nginx, Caddy, Cloudflare Tunnel, etc.) in front of
# MINI_APP_HOST:MINI_APP_PORT and point this at its public HTTPS address.
MINI_APP_DOMAIN=
# Host/port the FastAPI server binds to locally (behind the reverse proxy above).
MINI_APP_HOST=0.0.0.0
MINI_APP_PORT=8080
# Optional: require premium for the Mini App itself, independent of
# individual quiz pricing. Off by default.
MINI_APP_REQUIRE_PREMIUM=false

# ---------------------------------------------------------------------------
# AI providers (optional fallback default keys, comma-separated)
# ---------------------------------------------------------------------------
OPENROUTER_DEFAULT_KEYS=

# ---------------------------------------------------------------------------
# Tuning (UNLIMITED -- no rate limits, no wait timers)
# ---------------------------------------------------------------------------

# Runner Bot's general-purpose rate limiter.
RATE_LIMIT_WINDOW=1
RATE_LIMIT_MAX_REQUESTS=999999
SESSION_TIMEOUT=999999
SESSION_CLEANUP_INTERVAL=999999
# Anti-cheat: answers faster than this many seconds (and wrong) count toward
# the anti-cheat flag. Matches the original bot's value.
CHEAT_SPEED_THRESHOLD=0.0
WATCHDOG_INTERVAL=999999
PAGE_SIZE=10
QUESTIONS_PER_PAGE=10
LEADERS_PAGE_SIZE=20
CACHE_EXPIRY=1

# Creator Bot's three named rate-limit buckets: (hits, window_seconds).
# UNLIMITED
CREATOR_RATE_LIMIT_DEFAULT_HITS=999999
CREATOR_RATE_LIMIT_DEFAULT_WINDOW=1
CREATOR_RATE_LIMIT_CREATE_HITS=999999
CREATOR_RATE_LIMIT_CREATE_WINDOW=1
CREATOR_RATE_LIMIT_STRICT_HITS=999999
CREATOR_RATE_LIMIT_STRICT_WINDOW=1

# Note: LOG_GROUP / REQUIRED_SUB_CHANNEL above also gate the Creator Bot's
# /start, /create, /myquizzes, /add commands behind channel membership.
# Leave both blank to disable that gate entirely.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com
GROQ_API_KEY=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
POLLINATIONS_MODEL=openai


